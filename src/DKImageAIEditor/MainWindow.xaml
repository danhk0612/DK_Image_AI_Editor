<Window x:Class="DKImageAIEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DK Image AI Editor"
        Icon="{StaticResource AppIcon}"
        Width="1500"
        Height="900"
        MinWidth="1100"
        MinHeight="720"
        Background="#EEF1F5"
        FontFamily="Segoe UI"
        AllowDrop="True"
        Loaded="MainWindow_Loaded"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DCE2EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#263244" />
            <Setter Property="BorderBrush" Value="#D7DEE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="#352E59" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#352E59" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,9" />
        </Style>

        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#35445B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#56657A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,7" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#202A38" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7A8595" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#2D3B51"
                BorderBrush="#223044"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="9" Background="#FFFFFF18" Margin="0,0,11,0">
                        <Image Source="{StaticResource AppIcon}" Width="30" Height="30" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DK Image AI Editor" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="OpenRouter 기반 이미지 편집" Foreground="#B9C5D5" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Button x:Name="SettingsButton"
                        Grid.Column="1"
                        Content="⚙  설정"
                        Style="{StaticResource HeaderButtonStyle}"
                        VerticalAlignment="Center"
                        Click="SettingsButtonWithRefresh_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="190" MaxWidth="310" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="350" MinWidth="300" MaxWidth="440" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button x:Name="NewConversationButton"
                            Grid.Row="0"
                            Content="＋  새 대화"
                            Style="{StaticResource ToolbarButtonStyle}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Margin="12,12,12,10"
                            HorizontalContentAlignment="Center"
                            Click="NewConversationButton_Click" />

                    <Border Grid.Row="1" BorderBrush="#E4E8EE" BorderThickness="0,1,0,1" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="이미지 대화" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="썸네일과 최신 요청 기준" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="ConversationList"
                             Grid.Row="2"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="8"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBoxItem IsEnabled="False" Padding="10">
                            <StackPanel>
                                <TextBlock Text="대화가 없습니다." FontWeight="SemiBold" />
                                <TextBlock Text="새 대화에서 이미지를 선택하세요." Margin="0,4,0,0" Foreground="#7A8290" TextWrapping="Wrap" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FAFBFC" BorderBrush="#E1E6ED" BorderThickness="0,0,0,1" Padding="10,8">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="편집 방식" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" Margin="4,0,10,0" />
                            <Button x:Name="FullEditModeButton" Content="전체 이미지" Style="{StaticResource ToolbarButtonStyle}" Click="FullEditModeButton_Click" />
                            <Button x:Name="RegionEditModeButton" Content="영역 편집" Style="{StaticResource ToolbarButtonStyle}" Click="RegionEditModeButton_Click" />
                            <Button x:Name="CropEditModeButton" Content="잘라서 편집" Style="{StaticResource ToolbarButtonStyle}" Click="CropEditModeButton_Click" />
                        </WrapPanel>
                    </Border>

                    <Grid x:Name="EditorSurface"
                          Grid.Row="1"
                          Margin="10"
                          Background="#171B22"
                          ClipToBounds="True"
                          MouseWheel="EditorSurface_MouseWheel"
                          MouseDown="EditorSurface_MouseDown"
                          MouseMove="EditorSurface_MouseMove"
                          MouseUp="EditorSurface_MouseUp">
                        <Grid x:Name="ImageViewport" Margin="12" ClipToBounds="True" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ViewportScaleTransform" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="ViewportTranslateTransform" X="0" Y="0" />
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <Image x:Name="EditorImage" Stretch="Uniform" Visibility="Collapsed" />

                            <Canvas x:Name="SelectionCanvas"
                                    Background="Transparent"
                                    Cursor="Cross"
                                    IsHitTestVisible="False"
                                    MouseLeftButtonDown="SelectionCanvas_MouseLeftButtonDown"
                                    MouseMove="SelectionCanvas_MouseMove"
                                    MouseLeftButtonUp="SelectionCanvas_MouseLeftButtonUp">
                                <Rectangle x:Name="SelectionRectangle" Visibility="Collapsed" Stroke="#FF58A6FF" StrokeThickness="2" Fill="#1858A6FF" StrokeDashArray="4,2" IsHitTestVisible="False" Panel.ZIndex="0" />
                                <Thumb x:Name="SelectionMoveThumb" Visibility="Collapsed" Cursor="SizeAll" DragDelta="SelectionMoveThumb_DragDelta" Panel.ZIndex="1">
                                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
                                </Thumb>
                                <Thumb x:Name="SelectionTopLeftThumb" Tag="TL" Width="12" Height="12" Visibility="Collapsed" Background="White" BorderBrush="#FF58A6FF" BorderThickness="2" Cursor="SizeNWSE" DragDelta="SelectionResizeThumb_DragDelta" Panel.ZIndex="2" />
                                <Thumb x:Name="SelectionTopRightThumb" Tag="TR" Width="12" Height="12" Visibility="Collapsed" Background="White" BorderBrush="#FF58A6FF" BorderThickness="2" Cursor="SizeNESW" DragDelta="SelectionResizeThumb_DragDelta" Panel.ZIndex="2" />
                                <Thumb x:Name="SelectionBottomLeftThumb" Tag="BL" Width="12" Height="12" Visibility="Collapsed" Background="White" BorderBrush="#FF58A6FF" BorderThickness="2" Cursor="SizeNESW" DragDelta="SelectionResizeThumb_DragDelta" Panel.ZIndex="2" />
                                <Thumb x:Name="SelectionBottomRightThumb" Tag="BR" Width="12" Height="12" Visibility="Collapsed" Background="White" BorderBrush="#FF58A6FF" BorderThickness="2" Cursor="SizeNWSE" DragDelta="SelectionResizeThumb_DragDelta" Panel.ZIndex="2" />
                            </Canvas>
                        </Grid>

                        <StackPanel x:Name="CanvasPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="68" Height="68" CornerRadius="18" Background="#252C36" HorizontalAlignment="Center"><Image Source="{StaticResource AppIcon}" Width="46" Height="46" /></Border>
                            <TextBlock Text="이미지를 열거나 이 창에 드래그해 놓으세요." Foreground="#C5CDD8" FontSize="15" Margin="0,14,0,0" HorizontalAlignment="Center" />
                            <TextBlock Text="휠: 확대/축소  ·  가운데 버튼: 이동" Foreground="#7E8998" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Background="#FAFBFC" BorderBrush="#E1E6ED" BorderThickness="0,1,0,0" Padding="9,7">
                        <WrapPanel HorizontalAlignment="Center">
                            <Button x:Name="SaveCurrentImageButton" Content="↓  저장" Style="{StaticResource ToolbarButtonStyle}" Click="SaveCurrentImageButton_Click" />
                            <Button x:Name="CompareOriginalButton" Content="원본 비교" Style="{StaticResource ToolbarButtonStyle}" Click="CompareOriginalButton_Click" />
                            <Button x:Name="ClearSelectionButton" Content="선택 해제" Style="{StaticResource ToolbarButtonStyle}" Click="ClearSelectionButton_Click" />
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="4" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#E4E8EE" BorderThickness="0,0,0,1" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="현재 대화" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="요청/결과 기록 · 텍스트 클릭 시 복사" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer x:Name="ChatHistoryScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="12">
                        <StackPanel x:Name="ChatHistoryPanel" PreviewMouseLeftButtonUp="ChatHistoryPanel_PreviewMouseLeftButtonUp">
                            <Border Background="#F2F4F7" CornerRadius="8" Padding="12">
                                <TextBlock Text="이미지를 선택하면 편집 대화가 시작됩니다." Foreground="#69717E" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#FAFBFC" BorderBrush="#E1E6ED" BorderThickness="0,1,0,0" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="OperationStatusTextBlock" Text="준비됨" Foreground="#69717E" FontSize="11" TextWrapping="Wrap" Margin="2,0,2,6" />
                            <ProgressBar x:Name="OperationProgressBar" Grid.Row="1" Height="5" Margin="0,0,0,8" IsIndeterminate="True" Visibility="Collapsed" />

                            <Border Grid.Row="2" Background="White" BorderBrush="#D7DEE8" BorderThickness="1" CornerRadius="8">
                                <TextBox x:Name="PromptTextBox" MinHeight="92" MaxHeight="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" Background="Transparent" BorderThickness="0" ToolTip="한글 자연어로 이미지 수정 내용을 입력하세요." />
                            </Border>

                            <Grid Grid.Row="3" Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="RequestModelComboBox" Grid.Column="0" Margin="0,0,8,0" MinHeight="38" VerticalContentAlignment="Center" DisplayMemberPath="DisplayName" SelectedValuePath="ModelId" IsEnabled="{Binding IsEnabled, ElementName=EditImageButton}" ToolTip="이번 이미지 수정에 사용할 모델을 선택합니다. 설정의 기본 모델은 시작값으로 사용됩니다." />
                                <Button x:Name="EditImageButton" Grid.Column="1" Content="이미지 수정" Style="{StaticResource PrimaryButtonStyle}" Margin="0" Click="EditImageWithModelButton_Click" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
