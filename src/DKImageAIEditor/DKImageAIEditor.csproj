<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DKImageAIEditor.App</AssemblyName>
    <RootNamespace>DKImageAIEditor</RootNamespace>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>DK Image AI Editor</Product>
    <Authors>참빛바다</Authors>
    <Copyright>Copyright © 2026 참빛바다</Copyright>
    <GeneratedApplicationIcon>$(MSBuildProjectDirectory)\DKImageAIEditor.ico</GeneratedApplicationIcon>
    <ApplicationIcon>$(GeneratedApplicationIcon)</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <Target Name="GenerateApplicationIcon" BeforeTargets="CoreCompile">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$base64 = [IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Assets\AppIcon.ico.base64'); [IO.File]::WriteAllBytes('$(GeneratedApplicationIcon)', [Convert]::FromBase64String($base64))&quot;" />
  </Target>

  <Target Name="RemoveGeneratedApplicationIcon" AfterTargets="Clean">
    <Delete Files="$(GeneratedApplicationIcon)" />
  </Target>
</Project>
