<Window x:Class="DKImageAIEditor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정"
        Width="640"
        Height="700"
        MinHeight="620"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="OpenRouter" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="이미지 편집 API 연결과 사용할 모델을 설정합니다."
                               Margin="0,5,0,20"
                               Foreground="#6F7785" />

                    <TextBlock Text="API Key" FontWeight="SemiBold" />
                    <Grid Margin="0,7,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ApiKeyPasswordBox"
                                     Grid.Column="0"
                                     Height="34"
                                     Padding="8,5"
                                     Margin="0,0,8,0" />
                        <TextBox x:Name="ApiKeyTextBox"
                                 Grid.Column="0"
                                 Height="34"
                                 Padding="8,5"
                                 Margin="0,0,8,0"
                                 Visibility="Collapsed"
                                 VerticalContentAlignment="Center" />
                        <Button x:Name="ToggleApiKeyVisibilityButton"
                                Grid.Column="1"
                                Width="40"
                                Height="34"
                                Content="👁"
                                FontSize="15"
                                ToolTip="API Key 표시/숨김"
                                Click="ToggleApiKeyVisibilityButton_Click" />
                    </Grid>
                    <TextBlock Text="API Key는 Windows 자격 증명 관리자에 저장됩니다."
                               Foreground="#7A8290"
                               FontSize="12"
                               Margin="0,0,0,20" />

                    <TextBlock Text="이미지 편집 모델" FontWeight="SemiBold" />

                    <RadioButton x:Name="PresetModelRadioButton"
                                 Content="기본 모델 선택"
                                 Margin="0,10,0,6"
                                 Checked="ModelMode_Checked" />
                    <ComboBox x:Name="PresetModelComboBox"
                              Height="34"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="ModelId"
                              Margin="20,0,0,12" />

                    <RadioButton x:Name="CustomModelRadioButton"
                                 Content="Custom 모델 ID 직접 입력"
                                 Margin="0,0,0,6"
                                 Checked="ModelMode_Checked" />
                    <TextBox x:Name="CustomModelTextBox"
                             Height="34"
                             Padding="8,5"
                             Margin="20,0,0,14"
                             ToolTip="예: provider/model-name" />

                    <Border Background="#F5F6F8" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="현재 사용 가능한 이미지 모델과 가격은 OpenRouter 컬렉션을 기준으로 확인하세요."
                                       TextWrapping="Wrap"
                                       Foreground="#596170" />
                            <TextBlock Margin="0,7,0,0">
                                <Hyperlink NavigateUri="https://openrouter.ai/collections/image-models"
                                           RequestNavigate="ImageModelsLink_RequestNavigate">
                                    OpenRouter Image Models 컬렉션 열기
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Separator Margin="0,22,0,18" />

                    <TextBlock Text="이미지 저장 위치" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="새 대화의 원본 복사본과 생성 결과를 대화별 폴더에 저장합니다."
                               Margin="0,5,0,12"
                               Foreground="#6F7785"
                               TextWrapping="Wrap" />

                    <RadioButton x:Name="AppDataStorageRadioButton"
                                 Content="앱 내부 저장 (기존 방식)"
                                 Margin="0,0,0,8"
                                 Checked="StorageMode_Checked" />
                    <RadioButton x:Name="SourceFolderStorageRadioButton"
                                 Content="원본 폴더 - 원본 이미지가 있는 위치에 대화별 폴더 생성"
                                 Margin="0,0,0,8"
                                 Checked="StorageMode_Checked" />
                    <RadioButton x:Name="CustomFolderStorageRadioButton"
                                 Content="특정 폴더 지정 - 지정한 위치에 대화별 폴더 생성"
                                 Margin="0,0,0,8"
                                 Checked="StorageMode_Checked" />

                    <Grid Margin="20,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CustomStoragePathTextBox"
                                 Height="34"
                                 Padding="8,5"
                                 VerticalContentAlignment="Center" />
                        <Button x:Name="BrowseStorageFolderButton"
                                Grid.Column="1"
                                Content="폴더 선택"
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Click="BrowseStorageFolderButton_Click" />
                    </Grid>
                    <TextBlock Text="저장 위치 변경은 새로 만드는 대화부터 적용됩니다."
                               Margin="20,7,0,0"
                               Foreground="#7A8290"
                               FontSize="12" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="취소" Width="90" Padding="10,7" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="저장"
                    Width="90"
                    Padding="10,7"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    BorderBrush="{StaticResource AccentBrush}"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
