<Window x:Class="DKImageAIEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DK Image AI Editor"
        Width="1500"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        Background="{StaticResource WindowBackgroundBrush}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        KeyDown="Window_KeyDown">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DK Image AI Editor"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="  ·  OpenRouter Image Editor"
                               Margin="8,2,0,0"
                               Foreground="#6F7785"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="NewConversationButton"
                            Content="새 대화"
                            Padding="16,7"
                            Margin="0,0,8,0"
                            Click="NewConversationButton_Click" />
                    <Button x:Name="SettingsButton"
                            Content="설정"
                            Padding="16,7"
                            Click="SettingsButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="330" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="이미지 대화" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="이미지별 편집 기록" Margin="0,3,0,0" Foreground="#7A8290" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="ConversationList"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="8">
                        <ListBoxItem IsEnabled="False" Padding="10">
                            <StackPanel>
                                <TextBlock Text="대화가 없습니다." FontWeight="SemiBold" />
                                <TextBlock Text="새 대화에서 이미지를 선택하세요."
                                           Margin="0,4,0,0"
                                           Foreground="#7A8290"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <Border Grid.Column="2"
                    Background="#1D1F24"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="EditorSurface" Grid.Row="0" ClipToBounds="True">
                        <Grid x:Name="ImageViewport" Margin="14" ClipToBounds="True">
                            <Image x:Name="EditorImage"
                                   Stretch="Uniform"
                                   Visibility="Collapsed" />
                            <Canvas x:Name="SelectionCanvas"
                                    Background="Transparent"
                                    Cursor="Cross"
                                    IsHitTestVisible="False"
                                    MouseLeftButtonDown="SelectionCanvas_MouseLeftButtonDown"
                                    MouseMove="SelectionCanvas_MouseMove"
                                    MouseLeftButtonUp="SelectionCanvas_MouseLeftButtonUp">
                                <Rectangle x:Name="SelectionRectangle"
                                           Visibility="Collapsed"
                                           Stroke="#FF3B82F6"
                                           StrokeThickness="2"
                                           Fill="#303B82F6"
                                           StrokeDashArray="4,2" />
                            </Canvas>
                        </Grid>
                        <TextBlock x:Name="CanvasPlaceholder"
                                   Text="이미지를 열거나 이 창에 드래그해 놓으세요."
                                   Foreground="#B9C0CC"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#262930"
                            BorderBrush="#393D46"
                            BorderThickness="0,1,0,0"
                            Padding="10">
                        <WrapPanel HorizontalAlignment="Center">
                            <Button x:Name="FullEditModeButton"
                                    Content="전체 편집"
                                    Padding="13,6"
                                    Margin="3"
                                    Click="FullEditModeButton_Click" />
                            <Button x:Name="RegionEditModeButton"
                                    Content="영역 편집"
                                    Padding="13,6"
                                    Margin="3"
                                    Click="RegionEditModeButton_Click" />
                            <Button x:Name="CropEditModeButton"
                                    Content="잘라서 편집"
                                    Padding="13,6"
                                    Margin="3"
                                    Click="CropEditModeButton_Click" />
                            <Button x:Name="ClearSelectionButton"
                                    Content="선택 해제"
                                    Padding="13,6"
                                    Margin="3"
                                    Click="ClearSelectionButton_Click" />
                            <Button x:Name="CompareOriginalButton"
                                    Content="원본 비교"
                                    Padding="13,6"
                                    Margin="3"
                                    Click="CompareOriginalButton_Click" />
                            <Button x:Name="SaveCurrentImageButton"
                                    Content="저장"
                                    Padding="13,6"
                                    Margin="3"
                                    Click="SaveCurrentImageButton_Click" />
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <Border Grid.Column="4"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Padding="14,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="현재 대화" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="수정 요청과 결과 기록" Margin="0,3,0,0" Foreground="#7A8290" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel x:Name="ChatHistoryPanel">
                            <Border Background="#F1F3F6" CornerRadius="8" Padding="12">
                                <TextBlock Text="이미지를 선택하면 편집 대화가 시작됩니다."
                                           Foreground="#69717E"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="OperationStatusTextBlock"
                                       Text="준비됨"
                                       Foreground="#69717E"
                                       FontSize="12"
                                       Margin="0,0,0,6" />

                            <ProgressBar x:Name="OperationProgressBar"
                                         Grid.Row="1"
                                         Height="7"
                                         Margin="0,0,0,8"
                                         IsIndeterminate="True"
                                         Visibility="Collapsed" />

                            <TextBox x:Name="PromptTextBox"
                                     Grid.Row="2"
                                     MinHeight="90"
                                     MaxHeight="180"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Padding="10"
                                     ToolTip="한글 자연어로 이미지 수정 내용을 입력하세요." />

                            <Button x:Name="EditImageButton"
                                    Grid.Row="3"
                                    Content="이미지 수정"
                                    HorizontalAlignment="Right"
                                    Margin="0,8,0,0"
                                    Padding="18,8"
                                    Background="{StaticResource AccentBrush}"
                                    Foreground="White"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    Click="EditImageButton_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
